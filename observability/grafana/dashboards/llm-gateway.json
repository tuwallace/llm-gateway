{
  "uid": "llm-gateway",
  "title": "LLM Gateway: teams",
  "tags": [
    "llm-gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])) * 60",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(litellm_total_tokens_metric_total{requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])) * 60",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Prompt + completion tokens, all teams."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (non-2xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\",status_code!~\"2..\"}[$__rate_interval])) / sum(rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "429 rate limits, exhausted budgets and upstream errors, as a share of all requests."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(litellm_cache_hits_metric_total{team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])) / sum(rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\",status_code=\"200\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Share of successful requests answered from the semantic cache."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests / min by team",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (team_alias) (rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])) * 60",
          "legendFormat": "{{team_alias}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens / min by team",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (team_alias) (rate(litellm_total_tokens_metric_total{requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])) * 60",
          "legendFormat": "{{team_alias}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 latency by team",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, team_alias) (rate(litellm_request_total_latency_metric_bucket{requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])))",
          "legendFormat": "{{team_alias}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Includes cache hits, which are fast; watch it rise when the cache is cold."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Non-2xx responses by team and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (team_alias, status_code) (rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\",status_code!~\"2..\"}[$__rate_interval])) * 60",
          "legendFormat": "{{team_alias}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": []
      },
      "options": {},
      "description": "429 = RPM/TPM limit, 422 = token quota (budget) exhausted."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit rate by team",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (team_alias) (rate(litellm_cache_hits_metric_total{team_alias!~\"litellm-internal-health-check|None\"}[$__rate_interval])) / sum by (team_alias) (rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\",status_code=\"200\"}[$__rate_interval]))",
          "legendFormat": "{{team_alias}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Uncached requests / min by node",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (model_id) (rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\",model_id=~\"node-.*|fallback-node.*|research-node\"}[$__rate_interval])) - (sum by (model_id) (rate(litellm_cache_hits_metric_total{team_alias!~\"litellm-internal-health-check|None\",model_id=~\"node-.*|fallback-node.*|research-node\"}[$__rate_interval])) or (0 * sum by (model_id) (rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",requested_model=~\"my-educational-model|my-fallback-model|research-model\",team_alias!~\"litellm-internal-health-check|None\",model_id=~\"node-.*|fallback-node.*|research-node\"}[$__rate_interval]))))) * 60",
          "legendFormat": "{{model_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": []
      },
      "options": {},
      "description": "Cache hits carry a node id but no node did any work, so they are subtracted. fallback-node is the llama3 fallback."
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Token quota remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT team_alias, GREATEST(1 - spend / NULLIF(max_budget, 0), 0) AS remaining FROM \"LiteLLM_TeamTable\" WHERE team_alias IN ('search', 'support', 'analytics', 'research', 'intern-sandbox') ORDER BY team_alias"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^remaining$/"
        }
      },
      "description": "1 - spend / max budget, from the enforced team spend in Postgres (read-only role). 1 token = $0.00001. Not taken from LiteLLM's remaining-budget gauge, which goes stale."
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Tokens remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT team_alias, GREATEST(max_budget - spend, 0) / 1e-05 AS tokens FROM \"LiteLLM_TeamTable\" WHERE team_alias IN ('search', 'support', 'analytics', 'research', 'intern-sandbox') ORDER BY team_alias"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^tokens$/"
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Node health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "litellm_deployment_state{api_base=~\"http://localhost:1143.*\"}",
          "legendFormat": "{{api_base}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "color": "green"
                },
                "1": {
                  "text": "degraded",
                  "color": "orange"
                },
                "2": {
                  "text": "down",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "description": "0 = healthy, 1 = partial outage, 2 = outage."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Rate limit used (per window) by team",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "litellm_team_rate_limit_used_metric{team_alias!~\"litellm-internal-health-check|None\"}",
          "legendFormat": "{{team_alias}} {{rate_limit_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Requests and tokens counted in the current rate-limit window."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Rejected requests (all routes, incl. unauthenticated)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status_code) (rate(litellm_proxy_total_requests_metric_total{route=\"/v1/chat/completions\",status_code!~\"2..\"}[$__rate_interval])) * 60",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": []
      },
      "options": {},
      "description": "Includes 401/403 from callers without a valid team key, which the team panels cannot show."
    }
  ]
}